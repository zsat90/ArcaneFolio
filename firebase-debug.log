[debug] [2026-06-21T22:06:25.324Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/arcane-folio/rulesets {"name":"projects/arcane-folio/rulesets/978e47ac-c7f9-42a7-b0a7-23956945b81c","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return isSignedIn() && request.auth.uid == uid;\n    }\n\n    // Legacy top-level collection — migration read/delete only (not used by normal app flow)\n    match /characters/{characterId} {\n      allow read, delete: if isSignedIn()\n        && resource.data.ownerId == request.auth.uid;\n    }\n\n    match /users/{uid} {\n      allow read, create, update, delete: if isOwner(uid);\n\n      match /characters/{characterId} {\n        allow create: if isOwner(uid)\n          && request.resource.data.ownerId == uid;\n\n        allow read, delete: if isOwner(uid);\n\n        allow update: if isOwner(uid)\n          && request.resource.data.ownerId == uid\n          && (!('ownerId' in resource.data) || resource.data.ownerId == uid);\n\n        match /sheet/{docId} {\n          allow read, create, update, delete: if isOwner(uid);\n        }\n\n        match /spellbook/{docId} {\n          allow read, create, update, delete: if isOwner(uid);\n        }\n\n        match /state/{docId} {\n          allow read, create, update, delete: if isOwner(uid);\n        }\n      }\n\n      match /npcs/{npcId} {\n        allow create: if isOwner(uid)\n          && request.resource.data.ownerId == uid;\n\n        allow read, delete: if isOwner(uid);\n\n        allow update: if isOwner(uid)\n          && request.resource.data.ownerId == uid\n          && (!('ownerId' in resource.data) || resource.data.ownerId == uid);\n\n        match /spellbook/{docId} {\n          allow read, create, update, delete: if isOwner(uid);\n        }\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-06-21T22:06:25.280543Z","metadata":{"services":["cloud.firestore"]}}
